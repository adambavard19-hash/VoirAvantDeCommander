# ─── Application ──────────────────────────────────────────────────────────────
# URL publique du site : elle est encodée dans les QR codes. En production :
# https://voiravantdecommander.fr — ne plus la changer une fois des QR imprimés.
APP_URL="http://localhost:3000"
# Secret aléatoire (≥ 32 caractères) pour signer les jetons de téléversement
# et anonymiser les IP. Générer avec : openssl rand -base64 48
APP_SECRET="change-me-with-a-long-random-secret-value"

# ─── Base de données PostgreSQL ───────────────────────────────────────────────
DATABASE_URL="postgresql://vadc:vadc_dev_password@localhost:5432/vadc"

# ─── Premier administrateur (utilisé par `npm run db:seed` / `npm run admin:create`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# ─── Stockage des fichiers ───────────────────────────────────────────────────
# local : fichiers dans STORAGE_LOCAL_DIR, servis par /files/… (développement, serveur unique)
# s3    : stockage compatible S3 (Cloudflare R2, Scaleway, AWS S3, MinIO…)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# URL publique (CDN) du bucket, ex. https://cdn.voiravantdecommander.fr
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="false"

# ─── Traduction automatique et extraction de menus (optionnel) ───────────────
# Sans clé, la traduction reste manuelle et l'extraction de PDF utilise
# uniquement l'analyseur heuristique intégré.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
DEEPL_API_KEY=""

# ─── Site vitrine ─────────────────────────────────────────────────────────────
# Adresse affichée dans la rubrique contact (laisser vide pour ne rien afficher).
CONTACT_EMAIL=""
CONTACT_PHONE=""
